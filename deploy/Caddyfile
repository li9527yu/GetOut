# Caddy 配置。放到 /etc/caddy/Caddyfile，把 game.example.com 换成你的域名。
# Caddy 会自动申请和续期 HTTPS 证书，前提是域名已经解析到这台机器，80 和 443 端口开着。
game.example.com {
	encode zstd gzip

	# 运行情况只给登上服务器的人看，不对外
	@stats path /stats
	respond @stats 404

	reverse_proxy 127.0.0.1:8787

	log {
		output file /var/log/caddy/getout.log {
			roll_size 20mb
			roll_keep 10
		}
	}
}
