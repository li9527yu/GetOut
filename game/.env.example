# 复制成 .env 再填。.env 不会进仓库
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_MODEL_STRONG=deepseek-v4-pro
# 下面三项不填就用默认值
# LLM_PER_MIN=30
# LLM_BURST=20
# LLM_DAILY_MAX=5000
# 想从别的机器看 /stats 时设一个长随机串，访问时带 ?token=它；不设就只有本机能看
# ADMIN_TOKEN=
# 模型的思考默认是关的（开着回话要多等好几秒，玩家等不到）。确实要开就取消下面这行的注释
# LLM_THINKING=1
# 服务按接口地址认是 DeepSeek 还是阿里云，各用各的参数关思考。地址认不出来时在这里指明: deepseek 或 aliyun
# LLM_PROVIDER=deepseek
# 别家的模型要带别的参数才能关思考时，写在这里（一行 JSON，会原样并进每次请求）
# LLM_EXTRA={"reasoning":{"enabled":false}}
